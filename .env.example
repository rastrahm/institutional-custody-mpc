# Copiar a `.env` y rellenar. Nunca commitear secretos.
MAINNET_RPC_URL=
SEPOLIA_RPC_URL=
PRIVATE_KEY=

# Multisig (Fase THRESH). OWNER_1 default = deployer si se omite.
OWNER_1=
OWNER_2=
OWNER_3=
THRESHOLD=2

# Cap de gasto diario en wei (Fase SPEND).
DAILY_LIMIT=1000000000000000000

# Delay del timelock de recovery en segundos (Fase LOCK).
TIMELOCK_DELAY=86400
